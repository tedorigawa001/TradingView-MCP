<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace the placeholders before loading: launchd expands neither ~ nor environment variables.
     /ABSOLUTE/PATH/TO/node is `command -v node`, /ABSOLUTE/PATH/TO/node_modules is `npm root -g`,
     /ABSOLUTE/PATH/TO/TradingView-MCP is a built checkout, and YOUR_USERNAME is your macOS user. -->
<dict>
  <key>Label</key>
  <string>com.tradingview-mcp.collection-health-policy-rate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/node_modules/bushido-tradingview-mcp/build/collectionHealthCli.js</string>
    <string>--scope</string>
    <string>policy-rate</string>
    <string>--notify</string>
    <string>--max-policy-rate-age-business-days</string>
    <string>0</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>15</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/collection-health-policy-rate.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/collection-health-policy-rate.stderr.log</string>
</dict>
</plist>
