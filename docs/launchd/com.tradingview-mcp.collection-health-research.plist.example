<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace the placeholders before loading: launchd expands neither ~ nor environment variables.
     /ABSOLUTE/PATH/TO/node is `command -v node`, /ABSOLUTE/PATH/TO/node_modules is `npm root -g`,
     /ABSOLUTE/PATH/TO/TradingView-MCP is a built checkout, and YOUR_USERNAME is your macOS user. -->
<dict>
  <key>Label</key>
  <string>com.tradingview-mcp.collection-health-research</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/node_modules/bushido-tradingview-mcp/build/collectionHealthCli.js</string>
    <string>--scope</string>
    <string>research</string>
    <string>--notify</string>
    <string>--max-research-age-hours</string>
    <string>2</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/collection-health-research.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/collection-health-research.stderr.log</string>
</dict>
</plist>
