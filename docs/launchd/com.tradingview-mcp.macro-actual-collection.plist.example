<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace the placeholders before loading: launchd expands neither ~ nor environment variables.
     /ABSOLUTE/PATH/TO/node is `command -v node`, /ABSOLUTE/PATH/TO/node_modules is `npm root -g`,
     /ABSOLUTE/PATH/TO/TradingView-MCP is a built checkout, and YOUR_USERNAME is your macOS user. -->
<dict>
  <key>Label</key>
  <string>com.tradingview-mcp.macro-actual-collection</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>build/officialMacroActualCollectionCli.js</string>
    <string>--events</string><string>/Users/YOUR_USERNAME/.tradingview-mcp/official-macro-events/us_cpi_2016_2026.json</string>
    <string>--events</string><string>/Users/YOUR_USERNAME/.tradingview-mcp/official-macro-events/us_nfp_2016_2026.json</string>
    <string>--events</string><string>/Users/YOUR_USERNAME/.tradingview-mcp/official-macro-events/fomc_statement_2016_2026.json</string>
    <string>--confirm-external-fetch</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/TradingView-MCP</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/macro-actual.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/macro-actual.stderr.log</string>
</dict>
</plist>
