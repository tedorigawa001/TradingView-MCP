<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace the placeholders before loading: launchd expands neither ~ nor environment variables. YOUR_USERNAME is your
     macOS user. The program is the owner-only wrapper script of docs/FX_HISTORY_DAILY.md, which reads
     OANDA_FX_HISTORY_ACCOUNT_ID and OANDA_FX_HISTORY_ACCESS_TOKEN from the login Keychain and runs
     build/fxHistoryDailyCli.js with these arguments; keep the token out of this file and out of `launchctl setenv`.
     The daily run must fall on Sunday to Thursday nights between 17:15 and 08:00 New York time: 08:30 and 13:00 JST on
     Monday to Friday do, in winter and summer. Elsewhere, pick local times that do. Of the runs before each deadline,
     the last one counts. -->
<dict>
  <key>Label</key>
  <string>com.tradingview-mcp.fx-history-daily-collection</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/bin/tradingview-mcp-fx-daily</string>
    <string>--instrument</string><string>EUR_USD</string>
    <string>--instrument</string><string>GBP_USD</string>
    <string>--instrument</string><string>USD_JPY</string>
    <string>--instrument</string><string>AUD_USD</string>
    <string>--instrument</string><string>AUD_NZD</string>
    <string>--lookback-weekdays</string><string>10</string>
    <string>--confirm-external-fetch</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/fx-history-daily.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.tradingview-mcp/fx-history-daily.stderr.log</string>
</dict>
</plist>
