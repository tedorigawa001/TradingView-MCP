{
  "name": "tradingview-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI analyze the TradingView desktop app via Chrome DevTools Protocol",
  "type": "module",
  "bin": {
    "tradingview-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "evaluate": "node build/evaluate.js",
    "walk-forward": "node build/walkForwardCli.js",
    "collect:first-seen": "node build/collectionCli.js collect",
    "coverage:first-seen": "node build/collectionCli.js coverage",
    "collect:policy-rates": "node build/policyRateCollectionCli.js --confirm-chart-switch",
    "collect:official-policy-rates": "node build/officialPolicyRateCollectionCli.js --confirm-exploratory-import",
    "collect:fx-history": "node build/fxHistoryCollectionCli.js --confirm-external-fetch",
    "collect:research-hypotheses": "node build/researchCollectionCli.js --confirm-chart-switch",
    "audit:event-studies": "node build/eventStudyFalsificationCli.js",
    "migrate:futures-oi-dates": "node build/migrateFuturesOiDatesCli.js",
    "migrate:futures-oi-cme-cleanup": "node build/migrateFuturesOiCmeCleanupCli.js",
    "pretest": "npm run build",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node test/smoke.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "scan:fx-csv": "node --max-old-space-size=8192 build/fxCsvFeatureScanCli.js --confirm-local-import",
    "aggregate:fx-csv": "node --max-old-space-size=8192 build/fxCsvM1AggregationCli.js --confirm-local-import",
    "collect:macro-events": "node build/officialMacroEventCollectionCli.js --confirm-external-fetch",
    "collect:oanda-flow": "node build/oandaFlowCollectionCli.js",
    "study:macro-events-m60": "node build/macroEvent60mCli.js --confirm-local-import",
    "preflight:macro-events-m60": "node build/macroEvent60mPreflightCli.js --confirm-local-import"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.10.0",
    "pdfjs-dist": "^6.1.200",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
