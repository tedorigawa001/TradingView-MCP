  "scripts": {
    "build": "tsc",
    "build:package": "tsc --sourceMap false",
    "prepack": "npm run build:package",
    "prepublishOnly": "npm test",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "evaluate": "node build/evaluate.js",
    "import:backtest-ledger": "node build/backtestLedgerCli.js",
    "import:forecast-set": "node build/forecastSetCli.js",
    "import:bar-series": "node build/barSeriesCli.js",
    "export:proxy-set": "node build/proxySetCli.js",
    "generate:research-evidence": "node build/researchEvidenceCli.js",
    "reproduce:research": "node build/researchReproductionCli.js",
    "walk-forward": "node build/walkForwardCli.js",
    "collect:first-seen": "node build/collectionCli.js collect",
    "coverage:first-seen": "node build/collectionCli.js coverage",
    "health:collections": "node build/collectionHealthCli.js",
    "repair:first-seen": "node build/firstSeenRepairCli.js",
    "collect:policy-rates": "node build/policyRateCollectionCli.js --confirm-chart-switch",
    "collect:official-policy-rates": "node build/officialPolicyRateCollectionCli.js --confirm-exploratory-import",
    "collect:fx-history": "node build/fxHistoryCollectionCli.js --confirm-external-fetch",
    "export:fx-history": "node build/fxHistoryExportCli.js",
    "collect:fx-daily": "node build/fxHistoryDailyCli.js --confirm-external-fetch",
    "collect:research-hypotheses": "node build/researchCollectionCli.js --confirm-chart-switch",
    "audit:event-studies": "node build/eventStudyFalsificationCli.js",
    "migrate:futures-oi-dates": "node build/migrateFuturesOiDatesCli.js",
    "migrate:futures-oi-cme-cleanup": "node build/migrateFuturesOiCmeCleanupCli.js",
    "pretest": "npm run build",
    "test": "node --test test/unit/*.test.mjs && npm run test:bookmap-addon",
    "build:bookmap-addon": "node bookmap-addon/build.mjs",
    "test:bookmap-addon": "node bookmap-addon/test.mjs",
    "build:native-bar-fs:synthetic": "node native/native_bar_fs/build.mjs",
    "test:native-bar-fs:synthetic": "node native/native_bar_fs/test.mjs",
    "test:integration": "node test/smoke.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "scan:fx-csv": "node --max-old-space-size=8192 build/fxCsvFeatureScanCli.js --confirm-local-import",
    "aggregate:fx-csv": "node --max-old-space-size=8192 build/fxCsvM1AggregationCli.js --confirm-local-import",
    "collect:macro-events": "node build/officialMacroEventCollectionCli.js --confirm-external-fetch",
    "collect:macro-consensus": "node build/tradingEconomicsMacroConsensusCli.js --confirm-external-fetch",
    "collect:macro-actual": "node build/officialMacroActualCollectionCli.js --confirm-external-fetch",
    "coverage:macro-surprise": "node build/macroSurpriseCoverageCli.js --confirm-local-import",
    "collect:oanda-flow": "node build/oandaFlowCollectionCli.js",
    "study:macro-events-m60": "node build/macroEvent60mCli.js --confirm-local-import",
    "preflight:macro-events-m60": "node build/macroEvent60mPreflightCli.js --confirm-local-import",
    "study:macro-events-m15": "node build/macroEventResponseCli.js --confirm-local-import",
    "reproduce:price-action-trap": "node build/priceActionTrapReproductionCli.js --confirm-local-import"
  },
